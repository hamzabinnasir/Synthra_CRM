# Base URL of the Synthra CRM API (the FastAPI backend), as the BROWSER reaches it.
# The refresh cookie is SameSite=strict, so the app and the API must be on the same site
# (e.g. app.example.com + api.example.com, or localhost:3000 + localhost:8000).
# The backend's CRM_PUBLIC_URL must equal the origin this app is served from.
NEXT_PUBLIC_API_URL=http://localhost:8000
