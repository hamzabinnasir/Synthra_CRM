# Copy to .env (never commit .env). Generate keys with:
#   python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"

CRM_ENV=development
CRM_DATABASE_URL=postgresql://user:password@localhost:5432/synthra_crm
CRM_AUTO_MIGRATE=true

CRM_MASTER_KEY=
CRM_MASTER_KEY_PREVIOUS=
CRM_JWT_SECRET=

CRM_PUBLIC_URL=http://localhost:3000
CRM_ALLOWED_ORIGINS=
CRM_TRUSTED_PROXY_HOPS=0

CRM_REQUIRE_EMAIL_VERIFICATION=true
CRM_SMTP_HOST=
CRM_SMTP_PORT=587
CRM_SMTP_USER=
CRM_SMTP_PASSWORD=
CRM_SMTP_FROM=Synthra CRM <no-reply@yourdomain.com>
