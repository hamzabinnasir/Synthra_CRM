# Copy to .env (never commit .env). Generate keys with:
#   python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"

# ---- Core -------------------------------------------------------------------------------------
CRM_ENV=development                 # development | production (production enforces https + SMTP)
CRM_DATABASE_URL=postgresql://user:password@localhost:5432/synthra_crm   # control-plane database
CRM_AUTO_MIGRATE=true               # apply control-plane migrations on startup

# ---- Secrets (required) -----------------------------------------------------------------------
CRM_MASTER_KEY=                     # base64, 32 bytes. Encrypts all stored credentials. Back it up!
CRM_MASTER_KEY_PREVIOUS=            # set only while rotating the master key
CRM_JWT_SECRET=                     # 32+ characters; also signs media URLs

# ---- URLs and CORS ----------------------------------------------------------------------------
CRM_PUBLIC_URL=http://localhost:3000        # the dashboard (must be https:// in production)
CRM_API_PUBLIC_URL=http://localhost:8000    # this API as Meta reaches it; webhook URLs are built from it
CRM_ALLOWED_ORIGINS=                        # extra comma-separated dashboard origins
CRM_TRUSTED_PROXY_HOPS=0                    # number of reverse proxies in front of the API (0-5)

# ---- Auth and email ---------------------------------------------------------------------------
CRM_REQUIRE_EMAIL_VERIFICATION=true
CRM_SMTP_HOST=                      # without it, development prints links to the server log
CRM_SMTP_PORT=587
CRM_SMTP_USER=
CRM_SMTP_PASSWORD=
CRM_SMTP_FROM=Synthra CRM <no-reply@yourdomain.com>

# ---- Optional tuning (defaults shown) ---------------------------------------------------------
# CRM_ALLOW_PRIVATE_DB_HOSTS=false  # true only when self-hosting alone (lets tenants reach private addresses)
# CRM_RUN_WORKER=true               # set false on API-only replicas
# CRM_WORKER_CONCURRENCY=8
# CRM_LLM_DAILY_CALLS=2000          # per workspace per UTC day
# CRM_LLM_TIMEOUT_SECONDS=25
# CRM_EMBEDDER=fastembed            # fastembed (downloads ~90 MB once) | hash (offline/dev)
# CRM_MAX_UPLOAD_BYTES=5000000
# CRM_MAX_MEDIA_BYTES=16000000
# CRM_MAX_KB_DOCUMENTS=200
# CRM_WEBHOOK_MAX_BODY_BYTES=1000000
# CRM_WEBHOOK_RATE_PER_MINUTE=1200
# CRM_GRAPH_VERSION=v21.0
# CRM_INSTAGRAM_GRAPH_VERSION=v25.0
# CRM_ACCESS_TTL_MINUTES=10
# CRM_REFRESH_TTL_DAYS=30
# CRM_LOGIN_MAX_FAILURES=5
# CRM_LOGIN_WINDOW_MINUTES=15
