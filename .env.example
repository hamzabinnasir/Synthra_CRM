# Production template. Copy to backend/.env (never commit it); the API reads that file at startup.
# Generate each key with:  python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
# Every variable (including optional tuning) is listed in backend/.env.example.

CRM_ENV=production

# Control-plane database: a PostgreSQL you run or rent (Supabase, Neon, RDS, or a local install). It only holds accounts,
# sessions and encrypted settings. Customers' own databases are separate.
CRM_DATABASE_URL=postgresql://synthra:CHANGE_ME@localhost:5432/synthra_crm
CRM_AUTO_MIGRATE=true

CRM_MASTER_KEY=            # base64, 32 bytes. Encrypts every stored credential. BACK THIS UP: without it saved credentials are unrecoverable.
CRM_JWT_SECRET=            # 32+ random characters

# Public HTTPS addresses. The dashboard and the API must be on the SAME SITE (for example app.example.com and
# api.example.com) because the login cookie is SameSite=strict.
CRM_PUBLIC_URL=https://app.example.com
CRM_API_PUBLIC_URL=https://api.example.com
CRM_TRUSTED_PROXY_HOPS=1   # number of reverse proxies in front of the API

# Embedding model cache: FASTEMBED_CACHE_PATH is set in deploy/synthra-api.service (it is not a CRM_* setting, so .env cannot carry it).
# For a local run, fastembed uses its default cache folder. Use CRM_EMBEDDER=hash to skip the ~90 MB download.

# Email (required in production while email verification is on)
CRM_SMTP_HOST=smtp.example.com
CRM_SMTP_PORT=587
CRM_SMTP_USER=
CRM_SMTP_PASSWORD=
CRM_SMTP_FROM=Synthra CRM <no-reply@example.com>

# Frontend: NEXT_PUBLIC_API_URL is baked in at build time. Put it in frontend/.env.production
# (NEXT_PUBLIC_API_URL=<the CRM_API_PUBLIC_URL value above>) BEFORE running `npm run build`.
